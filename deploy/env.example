# Скопируй в backend/.env на сервере и заполни. В git не коммитить.

ASR_PROVIDER=remote
ASR_SERVICE_URL=https://<pod-id>-8000.proxy.runpod.net
ASR_SERVICE_API_KEY=<asr-service-key>
ASR_SERVICE_TIMEOUT=900
ASR_LANGUAGE=kazakh

LLM_PROVIDER=deepseek
LLM_API_KEY=<deepseek-key>
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_BATCH_SIZE=200
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

KEEP_AUDIO=0

# Каталог с SQLite. В Docker монтируется как volume.
SHALAEMES_DATA_DIR=/data

# HTTP-сервер (читает run_server.py).
PORT=8080
WEB_CONCURRENCY=1
LOG_LEVEL=info
FORWARDED_ALLOW_IPS=*

# Опционально: если задан, все /api/* требуют Authorization: Bearer <token>.
# Оставь пустым, пока Android-клиент не умеет отправлять токен.
API_TOKEN=

# OpenAPI /docs, /redoc, /openapi.json. Для публичного продакшена поставь 0.
DOCS_ENABLED=1
